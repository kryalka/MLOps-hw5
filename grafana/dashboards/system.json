      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[30s]))",
          "legendFormat": "",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
