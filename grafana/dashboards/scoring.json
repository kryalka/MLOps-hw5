    {
      "title": "SQL: результаты по версиям модели",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "PostgreSQL: только выбранный период, штат и мерчант.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT model_version AS \"Версия\", count(*) AS \"Скоров\",\n       avg(fraud_flag)::double precision AS \"Доля фрода\",\n       avg(score) AS \"Средний скор\"\nFROM scores WHERE $__timeFilter(created_at) AND ('__all' IN (${us_state:sqlstring}) OR us_state IN (${us_state:sqlstring})) AND ('__all' IN (${merch:sqlstring}) OR merch IN (${merch:sqlstring}))\nGROUP BY model_version ORDER BY model_version",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Доля фрода"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 9
    },
    {
      "title": "SQL: плотность скоров — выбранные штат и мерчант",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "20 равных интервалов шириной 0.05. Плотность = число в интервале / (всего × 0.05), площадь равна 1 для непустого среза.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "WITH selected AS (\n    SELECT least(floor(score * 20)::int, 19) AS bin\n    FROM scores WHERE $__timeFilter(created_at) AND ('__all' IN (${us_state:sqlstring}) OR us_state IN (${us_state:sqlstring})) AND ('__all' IN (${merch:sqlstring}) OR merch IN (${merch:sqlstring}))\n), counts AS (SELECT bin, count(*) AS n FROM selected GROUP BY bin)\nSELECT to_char(b * 0.05, '0.00') || '–' || to_char((b + 1) * 0.05, '0.00') AS \"Скор\",\n       coalesce(n, 0)::double precision / greatest((SELECT count(*) FROM selected), 1) / 0.05 AS \"Плотность\"\nFROM generate_series(0, 19) b LEFT JOIN counts ON counts.bin = b ORDER BY b",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85
          }
        },
        "overrides": []
      },
