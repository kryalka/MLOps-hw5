    {
      "title": "SQL: TPS — выбранные штат и мерчант",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Записанные скоры по 10-секундным окнам. Время фактической записи в БД.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT $__timeGroupAlias(created_at, '10s', 0), count(*) / 10.0 AS \"TPS\"\nFROM scores WHERE $__timeFilter(created_at) AND ('__all' IN (${us_state:sqlstring}) OR us_state IN (${us_state:sqlstring})) AND ('__all' IN (${merch:sqlstring}) OR merch IN (${merch:sqlstring}))\nGROUP BY 1 ORDER BY 1",
          "format": "time_series",
