    {
      "title": "SQL: доля фрода по категориям — последние 1000",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Сначала последние 1000 записанных транзакций, затем фильтры штата и мерчанта. Выбор периода здесь не применяется.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "WITH recent AS (SELECT * FROM scores ORDER BY id DESC LIMIT 1000)\nSELECT cat_id AS \"Категория\", avg(fraud_flag)::double precision AS \"Доля фрода\"\nFROM recent WHERE ('__all' IN (${us_state:sqlstring}) OR us_state IN (${us_state:sqlstring})) AND ('__all' IN (${merch:sqlstring}) OR merch IN (${merch:sqlstring})) GROUP BY cat_id ORDER BY 2 DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
