    },
    {
      "title": "SQL: сумма подозрительных платежей по мерчантам",
      "type": "barchart",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Топ-10 по сумме платежей с флагом модели. Помогает выбрать мерчантов для ручной проверки; это не подтверждённые потери.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT merch AS \"Мерчант\", sum(amount) AS \"Сумма\"\nFROM scores WHERE $__timeFilter(created_at) AND ('__all' IN (${us_state:sqlstring}) OR us_state IN (${us_state:sqlstring})) AND ('__all' IN (${merch:sqlstring}) OR merch IN (${merch:sqlstring})) AND fraud_flag = 1\nGROUP BY merch ORDER BY sum(amount) DESC LIMIT 10",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85
          }
        },
